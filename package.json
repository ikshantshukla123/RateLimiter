{
  "name": "distributed-rate-limiter",
  "version": "0.1.0",
  "description": "Production-style distributed rate limiter in Node.js + TypeScript with Redis, Prometheus, Grafana and k6",
  "type": "commonjs",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "dev": "tsx watch src/app.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "load": "k6 run tests/load/rate-limiter.js",
    "load:steady": "k6 run --env SCENARIO=steady tests/load/rate-limiter.js",
    "infra:up": "docker compose up --build",
    "infra:down": "docker compose down -v"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "http-proxy-middleware": "^3.0.0",
    "ioredis": "^5.3.2",
    "pino": "^9.4.0",
    "pino-http": "^10.1.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.6.2",
    "vitest": "^2.1.3",
    "eslint": "^9.12.0",
    "@eslint/js": "^9.12.0",
    "typescript-eslint": "^8.8.0",
    "prettier": "^3.3.3"
  },
  "license": "MIT"
}
